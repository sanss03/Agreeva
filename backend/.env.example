PORT=5000

# Get a key from https://console.groq.com/keys - server-side only, never expose to the browser
GROQ_API_KEY=your_groq_api_key_here

# Deployed frontend URL used for CORS (set this on Render for your frontend service)
# Leave unset for local development (defaults to allowing all origins)
FRONTEND_URL=https://your-frontend-name.onrender.com
